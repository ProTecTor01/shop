<% content_for :header do %>
<section class="hero is-warning">
  <div class="hero-body">
    <div class="container">
      <h1 class="title">
        Browse new products
      </h1>
    </div>
  </div>
</section>
<% end %>

<div class="product-index-grid pt4">
  <% @products.each do |product| %>

    <div class="product border-light">
      <div class="product-thumb">
      <%= link_to image_tag(product.image_url), product if product.image? %>
      <% if product.condition? %>
        <div class="condition">
          <span class="tag is-dark"><%= product.condition %></span>
        </div>
      <% end %>
      </div>


    <div class="pa3">

      <h3 class="fw7 f4 title"><%= link_to product.title, product %></h3>

      <p class="has-text-gray fg pt1">Sold by: <%= product_author(product) %></p>

      <p class="f3 fw6 has-text-right pt2 price"><%= number_to_currency(product.price) %></p>

      <%= button_to 'Add to cart', line_items_path(product_id: product.id), class: "button is-small is-warning" %>

      <% if user_signed_in? && product.user == current_user %>
        <%= link_to 'Edit', edit_product_path(product), class: "button is-small" %>
        <%= button_to 'Delete', product_path(product), method: :delete,
              form: { onsubmit: "return confirm('Are you sure?')" }, class: "button is-small" %>
      <% end %>

    </div>
  </div>
  <% end %>
</div>
